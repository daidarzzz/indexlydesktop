{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IndexLy Desktop",
  "version": "0.1.0",
  "identifier": "net.daida.indexly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IndexLy Desktop — Gestor de Índices Locales",
        "width": 1000,
        "height": 780,
        "minWidth": 640,
        "minHeight": 500,
        "center": true
      },
      {
        "label": "spotlight",
        "title": "Spotlight",
        "url": "index.html?window=spotlight",
        "width": 660,
        "height": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
